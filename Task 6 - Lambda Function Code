import boto3
from botocore.exceptions import ClientError

# Initialize AWS clients
s3 = boto3.client("s3")
sns = boto3.client("sns")

# Configuration
BUCKET_NAME = "khushboo-s3-cleanup-2026"
SNS_TOPIC_ARN = "arn:aws:sns:us-east-1:230470759851:DailyAWSCostAlertTopic"


def lambda_handler(event, context):

    print(f"Starting public access audit for bucket: {BUCKET_NAME}")

    public_buckets = []

    # Audit the configured bucket
    buckets = [{"Name": BUCKET_NAME}]

    for bucket in buckets:

        bucket_name = bucket["Name"]
        is_public = False

        print(f"Checking bucket: {bucket_name}")

        # Check Block Public Access configuration
        try:
            response = s3.get_public_access_block(Bucket=bucket_name)

            config = response["PublicAccessBlockConfiguration"]

            if not all(config.values()):
                is_public = True
                print("Block Public Access is disabled.")

        except ClientError:
            print("Block Public Access configuration not found.")
            is_public = True

        # Check Bucket Policy Status
        try:
            policy = s3.get_bucket_policy_status(Bucket=bucket_name)

            if policy["PolicyStatus"]["IsPublic"]:
                is_public = True
                print("Bucket Policy is public.")

        except ClientError:
            print("No public bucket policy found.")

        # Check Bucket ACL
        try:
            acl = s3.get_bucket_acl(Bucket=bucket_name)

            for grant in acl["Grants"]:

                grantee = grant.get("Grantee", {})

                if (
                    grantee.get("Type") == "Group"
                    and "AllUsers" in grantee.get("URI", "")
                ):
                    is_public = True
                    print("Bucket ACL allows public access.")

        except ClientError:
            print("Unable to retrieve Bucket ACL.")

        if is_public:
            public_buckets.append(bucket_name)

    # Send SNS notification
    if public_buckets:

        message = (
            "Public S3 Bucket(s) detected:\n\n"
            + "\n".join(public_buckets)
        )

        sns.publish(
            TopicArn=SNS_TOPIC_ARN,
            Subject="S3 Public Access Alert",
            Message=message,
        )

        print("SNS Alert Sent!")

    else:
        print("No public buckets found.")

    return {
        "statusCode": 200,
        "message": "S3 Public Access Audit Completed",
        "publicBuckets": public_buckets
    }
